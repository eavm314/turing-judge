AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_URL=http://localhost:3000

DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Variables for seeders
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Variable for e2e tests
NEXT_PUBLIC_ENV=test
# Judging. Set JUDGE_WORKER=1 only on standalone/self-hosted deploys to judge submissions on a
# worker thread; leave it unset on Vercel, which judges inline. The rest are optional overrides.
JUDGE_WORKER=0
JUDGE_WORKER_TIMEOUT_MS=15000
JUDGE_WORKER_MEMORY_MB=256
